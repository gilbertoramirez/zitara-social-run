# Neon Postgres — connection string desde https://console.neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Gmail - Envío de correos
# Usa una "Contraseña de aplicación" de Google (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=

# Contraseña para acceder al panel de administración (/admin)
ADMIN_PASSWORD=

# URL base de la aplicación
NEXT_PUBLIC_BASE_URL=http://localhost:3000
